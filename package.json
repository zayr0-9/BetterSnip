{
  "name": "better-snip",
  "version": "0.1.8",
  "description": "Lightweight tray-first screen snipping app with foreground-app filenames.",
  "productName": "BetterSnip",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean:dev": "node -e \"require('fs').rmSync('.dev-dist',{recursive:true,force:true})\"",
    "build:main": "tsc --project tsconfig.main.json",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:renderer": "vite build",
    "build:ts": "pnpm clean && pnpm build:renderer && pnpm build:main",
    "build:run": "pnpm build:ts && electron .",
    "start": "pnpm build:run",
    "dev": "pnpm clean:dev && concurrently -k -n vite,tsc,electron -c cyan,yellow,green \"vite --host 127.0.0.1\" \"tsc --project tsconfig.main.json --outDir .dev-dist --watch --preserveWatchOutput\" \"wait-on .dev-dist/main.js http://127.0.0.1:5173/settings.html && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 nodemon --watch .dev-dist --ext js,json --exec electron .dev-dist/main.js\"",
    "build": "pnpm build:ts && pnpm build:native && electron-builder --win nsis portable"
  },
  "keywords": [
    "electron",
    "screenshot",
    "snip"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.bettersnip.app",
    "productName": "BetterSnip",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist/native/**/*",
      "package.json",
      "node_modules/fabric/dist/index.min.js",
      "!**/*.map"
    ],
    "asarUnpack": [
      "dist/native/win-recorder.exe",
      "dist/native/clipboard-file.exe"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "BetterSnip.Setup.${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "BetterSnip-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "fabric": "^7.3.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
